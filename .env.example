# =============================================================================
#  Copy to .env and fill in.  .env is git-ignored and must be chmod 600.
# =============================================================================

# --- Tailscale -----------------------------------------------------------------
# Auth key used ONLY on first login. After that the node identity is stored in
# the tailscale-state volume and TS_AUTH_ONCE=true keeps it from re-authing.
#   Reusable + Ephemeral=OFF + (optionally) pre-approved + tagged, e.g.
#   tskey-auth-kXXXXXXXCNTRL-XXXXXXXXXXXXXXXXXXXXXXXX
# Leave empty to fall back to the interactive login URL flow
# (`docker exec -it tailscale tailscale up`).
TS_AUTHKEY=

# Hostname this node gets in your tailnet (also the DNS name if MagicDNS is on).
TS_HOSTNAME=adguard-dns

# Host port published for the WireGuard tunnel. Must match the
# TS_TAILSCALED_EXTRA_ARGS --port=41641 in docker-compose.yml.
TS_WG_PORT=41641

# Flags for `tailscale up`.
#   --advertise-exit-node   offer this node as an exit node to the tailnet.
#                           Also needs IP forwarding (docker-compose sysctls)
#                           and admin approval in the Tailscale console.
#   --accept-routes=true    honour subnet routes advertised by other tailnet
#                           nodes (needed to reach a private subnet behind a
#                           subnet router). Drop this if you want the DNS box
#                           isolated from the rest of your private networks.
#   --accept-dns=false      do not rewrite the container's resolv.conf
#   --netfilter-mode=on     let tailscaled manage its own iptables rules. Needed
#                           for exit-node NAT; (was `off` before exit node).
#   --ssh=false             no Tailscale SSH on the DNS box
# NOTE: --port is a *tailscaled* flag, not a `tailscale up` flag. It belongs in
# TS_TAILSCALED_EXTRA_ARGS (set in docker-compose.yml), not here.
TS_EXTRA_ARGS=--advertise-exit-node --accept-routes=true --accept-dns=false --netfilter-mode=on --ssh=false

# --- AdGuard Home --------------------------------------------------------------
# Admin credentials for the web UI (used once, to seed AdGuardHome.yaml).
ADGUARD_ADMIN_USER=admin
ADGUARD_ADMIN_PASSWORD=

# Ports AdGuard listens on, inside the shared tailscale container namespace.
ADGUARD_DNS_PORT=53
ADGUARD_WEB_PORT=80

# Upstream resolvers AdGuard forwards to. For anything richer than this
# (upstream_mode, bootstrap_dns, blocklists, rewrites) use
# adguard/overrides.yaml + scripts/apply-overrides.py instead.
ADGUARD_UPSTREAM_1=https://dns.quad9.net/dns-query
ADGUARD_UPSTREAM_2=https://dns.cloudflare.com/dns-query
