*.log
data/
rollback/
*.bak
*.bak-*

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- editors / OS ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
